    <string name="settings_section_privacy">Datenschutz &amp; Netzwerk</string>
    <string name="settings_discoverable_title">Erreichbar sein</string>
    <string name="settings_discoverable_subtitle">Wird dies deaktiviert, stoppt das Tor-Netzwerk und der Hintergrunddienst vollständig - niemand findet dich, aber die App verbraucht keinen zusätzlichen Akku.</string>
    <string name="settings_auto_accept_title">Freundschaftsanfragen automatisch annehmen</string>
    <string name="settings_auto_accept_subtitle">Neue Kontakte werden sofort hinzugefügt, ohne deine Bestätigung.</string>
    <string name="settings_section_mistral">Mistral AI</string>
    <string name="settings_mistral_enabled_title">Mistral-KI-Assistenten verwenden</string>
    <string name="settings_mistral_enabled_subtitle">Die einzige Funktion, bei der Text dein Gerät verlässt - er wird mit deinem eigenen API-Schlüssel direkt an die Server von Mistral AI gesendet.</string>
    <string name="settings_mistral_show_contact_title">KI-Assistenten als Kontakt anzeigen</string>
    <string name="settings_mistral_show_contact_subtitle">Ein dauerhafter Eintrag in Kontakte und der Chatliste.</string>
    <string name="settings_mistral_model_label">Modell</string>
    <string name="settings_mistral_keys_label">API-Schlüssel (werden der Reihe nach probiert)</string>
