    <string name="app_name">Hertz Chat</string>

    <string name="onboarding_welcome_title">Willkommen bei Hertz Chat</string>
    <string name="onboarding_intro">Hertz Chat ist eine rein dezentrale, Ende-zu-Ende-verschlüsselte Chat-App. Kein Server speichert deine Nachrichten, Kontakte oder Medien – alles bleibt nur auf deinem Gerät und ist Ende-zu-Ende verschlüsselt.</string>
    <string name="onboarding_nickname_label">Spitzname (optional)</string>
    <string name="onboarding_nickname_hint">Lässt du das Feld leer, bekommst du einen anonymen Spitznamen. Eine Registrierung per Telefonnummer oder E-Mail ist nicht nötig – deine Identität ist nur an dieses Gerät gebunden.</string>
