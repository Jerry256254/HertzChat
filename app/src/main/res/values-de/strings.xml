    <string name="settings_section_privacy">Datenschutz &amp; Netzwerk</string>
    <string name="settings_discoverable_title">Erreichbar sein</string>
    <string name="settings_discoverable_subtitle">Wird dies deaktiviert, stoppt die Netzwerkverbindung (Relays) und der Hintergrunddienst vollständig - niemand findet dich, aber die App verbraucht keinen zusätzlichen Akku.</string>
    <string name="settings_auto_accept_title">Freundschaftsanfragen automatisch annehmen</string>
    <string name="settings_auto_accept_subtitle">Neue Kontakte werden sofort hinzugefügt, ohne deine Bestätigung.</string>
    <string name="settings_section_assistant">KI-Assistent</string>
    <string name="settings_assistant_about">Der KucLab-Hertz-KI-Assistent (kuclab.org/hertz), direkt in die App eingebaut. Du meldest dich mit deinem KucLab-Konto an und die Anmeldung bleibt gespeichert.</string>
    <string name="settings_assistant_show_title">KI-Assistenten anzeigen</string>
