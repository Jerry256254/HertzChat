    <string name="settings_allow_mistral_title">Povolit ostatním @Mistral u mých zpráv</string>
    <string name="settings_allow_mistral_subtitle">Když to někdo v konverzaci s tebou napíše @Mistral, smí AI vidět a použít tvoje zprávy jako kontext. Vypnutím se tvoje zprávy z kontextu vynechají.</string>
