    <string name="settings_auto_accept_subtitle">Nové kontakty se přidají rovnou, bez tvého potvrzení.</string>
    <string name="settings_section_assistant">AI asistent</string>
    <string name="settings_assistant_about">AI asistent KucLab Hertz (kuclab.org/hertz) zabudovaný přímo v appce. Přihlásíš se svým KucLab účtem a login zůstane uložený.</string>
