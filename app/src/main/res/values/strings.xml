    <string name="settings_discoverable_title">Být dosažitelný</string>
    <string name="settings_discoverable_subtitle">Vypnutím se úplně zastaví síťové připojení (relay) i služba na pozadí - nikdo tě nenajde ani ti nemůže poslat zprávu, ale appka nespotřebovává baterii navíc.</string>
