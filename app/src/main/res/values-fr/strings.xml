    <string name="app_name">Hertz Chat</string>

    <string name="onboarding_welcome_title">Bienvenue sur Hertz Chat</string>
    <string name="onboarding_intro">Hertz Chat est une application de messagerie purement pair-à-pair et chiffrée de bout en bout. Aucun serveur ne stocke tes messages, contacts ou fichiers multimédias - tout reste uniquement sur ton appareil et est chiffré de bout en bout.</string>
    <string name="onboarding_nickname_label">Pseudo (facultatif)</string>
    <string name="onboarding_nickname_hint">Si tu laisses ce champ vide, un pseudo anonyme sera généré. Aucune inscription par numéro de téléphone ou e-mail n\'est nécessaire - ton identité est liée uniquement à cet appareil.</string>
