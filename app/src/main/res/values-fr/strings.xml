    <string name="settings_mistral_enabled_title">Utiliser l\'assistant Mistral AI</string>
    <string name="settings_mistral_enabled_subtitle">La seule fonction où le texte quitte ton appareil - il est envoyé directement aux serveurs de Mistral AI avec ta propre clé API.</string>
    <string name="settings_mistral_show_contact_title">Afficher l\'assistant IA comme contact</string>
