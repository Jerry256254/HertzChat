    <string name="settings_discoverable_subtitle">La désactivation arrête complètement le réseau Tor et le service en arrière-plan - personne ne peut te trouver, mais l\'appli ne consomme pas de batterie supplémentaire.</string>
    <string name="settings_auto_accept_title">Accepter automatiquement les demandes d\'ami</string>
    <string name="settings_auto_accept_subtitle">Les nouveaux contacts sont ajoutés directement, sans ta confirmation.</string>
