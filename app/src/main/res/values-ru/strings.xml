    <string name="onboarding_show_privacy">Посмотреть конфиденциальность</string>
    <string name="onboarding_create_identity">Создать личность и начать</string>
    <string name="onboarding_restore_qr">У меня уже есть личность на другом устройстве - сканировать QR</string>
