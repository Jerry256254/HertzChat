    <string name="app_name">Hertz Chat</string>

    <string name="onboarding_welcome_title">Bienvenido a Hertz Chat</string>
    <string name="onboarding_intro">Hertz Chat es una aplicación de chat puramente de igual a igual (P2P) y cifrada de extremo a extremo. Ningún servidor guarda tus mensajes, contactos ni archivos multimedia: todo permanece solo en tu dispositivo y está cifrado de extremo a extremo.</string>
    <string name="onboarding_nickname_label">Apodo (opcional)</string>
    <string name="onboarding_nickname_hint">Si dejas este campo vacío, se generará un apodo anónimo. No hace falta registrarse con número de teléfono ni correo electrónico: tu identidad está vinculada solo a este dispositivo.</string>
