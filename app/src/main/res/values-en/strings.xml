    <string name="settings_discoverable_title">Be reachable</string>
    <string name="settings_discoverable_subtitle">Turning this off fully stops the Tor network and the background service - nobody can find or message you, but the app uses no extra battery.</string>
    <string name="settings_auto_accept_title">Auto-accept friend requests</string>
    <string name="settings_auto_accept_subtitle">New contacts get added right away, without your confirmation.</string>
