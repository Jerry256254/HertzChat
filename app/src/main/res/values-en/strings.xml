    <string name="onboarding_welcome_title">Welcome to Hertz Chat</string>
    <string name="onboarding_intro">Hertz Chat is a purely peer-to-peer, end-to-end encrypted chat app. No server stores your messages, contacts or media – everything stays only on your device and is end-to-end encrypted.</string>
    <string name="onboarding_nickname_label">Nickname (optional)</string>
    <string name="onboarding_nickname_hint">Leave this blank and you\'ll get an anonymous nickname. No phone number or e-mail registration is needed – your identity is bound only to this device.</string>
